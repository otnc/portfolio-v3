{
	"name": "portfolio-v3",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"dev": "concurrently -n astro,server -c cyan,magenta \"astro dev\" \"pnpm --filter marron-portfolio-server dev\"",
		"dev:astro": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@astrojs/preact": "^6.0.5",
		"@primer/octicons": "^19.38.0",
		"astro": "^7.3.3",
		"ofetch": "^1.5.1",
		"preact": "^10.29.8",
		"simple-icons": "^16.31.0",
		"subset-font": "^2.7.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"astro-eslint-parser": "^3.1.0",
		"concurrently": "^10.0.5",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^3.2.1",
		"globals": "^17.12.0",
		"prettier": "^3.9.7",
		"prettier-plugin-astro": "^1.0.1",
		"typescript-eslint": "^8.70.0"
	}
}
