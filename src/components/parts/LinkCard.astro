---
import Icon from './Icon.astro';
import { getServiceIcon } from '../../lib/icons';

interface Props {
	title: string;
	url: string;
	iconSlug?: string;
	iconSrc?: string;
}

const { title, url, iconSlug, iconSrc } = Astro.props;
const serviceIcon = iconSlug ? getServiceIcon(iconSlug) : undefined;
---

<a class="link-card" href={url} target="_blank" rel="noopener noreferrer">
	<div class="link-icon">
		{
			serviceIcon ? (
				<span
					class="service-icon"
					style={{ backgroundColor: `#${serviceIcon.hex}1a`, color: `#${serviceIcon.hex}` }}
					set:html={serviceIcon.svg}
				/>
			) : (
				<Icon src={iconSrc} alt="" size="36px" initial={title.charAt(0)} />
			)
		}
	</div>
	<div class="info">
		<p class="title">{title}</p>
		<p class="url">{url}</p>
	</div>
</a>

<style>
	.link-card {
		display: grid;
		grid-template-columns: 36px minmax(0, 1fr);
		align-items: center;
		gap: 12px;
		padding: 8px 10px;
		border-radius: var(--radius-sm);
		transition: background-color 0.15s;
	}

	.link-card:hover {
		background-color: var(--color-surface-alt);
	}

	.info {
		min-width: 0;
	}

	.service-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		padding: 8px;
		border-radius: 100%;
	}

	.service-icon :global(svg) {
		width: 100%;
		height: 100%;
		fill: currentColor;
	}

	.title {
		margin: 0;
		font-size: 16px;
		font-weight: 600;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.url {
		margin: 0;
		color: var(--color-text-light);
		font-size: 13px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>
