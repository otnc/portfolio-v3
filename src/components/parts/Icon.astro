---
interface Props {
	src?: string;
	alt?: string;
	size?: string;
	initial?: string;
}

const { src, alt = '', size = '100%', initial = '?' } = Astro.props;
---

{src ? (
	<Fragment>
		<img
			class="icon"
			src={src}
			alt={alt}
			style={{ width: size, height: size }}
			onerror="this.style.display='none';this.nextElementSibling.style.removeProperty('display')"
		/>
		<div
			class="icon icon-fallback"
			style={{ width: size, height: size, display: 'none' }}
			aria-hidden={alt === ''}
		>
			{initial}
		</div>
	</Fragment>
) : (
	<div class="icon icon-fallback" style={{ width: size, height: size }} aria-hidden={alt === ''}>
		{initial}
	</div>
)}

<style>
	.icon {
		border-radius: 100%;
		object-fit: cover;
	}

	.icon-fallback {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-accent-gradient);
		color: var(--color-surface);
	}
</style>
