---
interface Props {
	src?: string;
	alt?: string;
	size?: string;
	initial?: string;
}

const { src, alt = '', size = '100%', initial = '?' } = Astro.props;
---

{
	src ? (
		<img class="icon" src={src} alt={alt} style={{ width: size, height: size }} />
	) : (
		<div class="icon icon-fallback" style={{ width: size, height: size }} aria-hidden={alt === ''}>
			{initial}
		</div>
	)
}

<style>
	.icon {
		border-radius: 100%;
		object-fit: cover;
	}

	.icon-fallback {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-accent-gradient);
		color: var(--color-surface);
	}
</style>
