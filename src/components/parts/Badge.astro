---
interface Props {
	icon?: string;
}

const { icon } = Astro.props;
---

<span class="badge">
	{icon && <span class="badge-icon">{icon}</span>}
	<slot />
</span>

<style>
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: 6px 14px;
		border-radius: 999px;
		background-color: var(--color-surface-alt);
		border: 1px solid var(--color-border);
		font-weight: 500;
		font-size: 13px;
		color: var(--color-text-light);
		transition: border-color 0.15s;
	}

	.badge-icon {
		font-size: 13px;
	}
</style>
