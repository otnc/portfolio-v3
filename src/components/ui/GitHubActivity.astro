---
import SectionHeading from '../parts/SectionHeading.astro';
import GitHubStats from '../islands/GitHubStats';
import type { GithubActivity } from '../../lib/githubActivity';

interface Props {
	activity: GithubActivity | null;
	profileUrl: string;
}

const { activity, profileUrl } = Astro.props;
---

<section class="github-activity-section">
	<SectionHeading>GitHub</SectionHeading>
	<GitHubStats client:load initial={activity} profileUrl={profileUrl} />
</section>
