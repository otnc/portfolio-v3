---
import SectionHeading from '../parts/SectionHeading.astro';
import MoreLink from '../parts/MoreLink.astro';
import BlogPosts from '../islands/BlogPosts';
import type { BlogPost } from '../../lib/blog';

interface Props {
	posts: BlogPost[];
	links: { label: string; url: string }[];
}

const { posts, links } = Astro.props;
---

<section class="blog-section">
	<SectionHeading>Blog</SectionHeading>
	<BlogPosts client:load initial={posts} />
	<div class="more-links">
		{links.map((link) => <MoreLink href={link.url} label={link.label} />)}
	</div>
</section>

<style>
	.more-links {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 8px;
	}
</style>
