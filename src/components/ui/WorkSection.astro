---
import SectionHeading from '../parts/SectionHeading.astro';
import MoreLink from '../parts/MoreLink.astro';
import WorkList from '../islands/WorkList';
import type { Repo } from '../../lib/github';

interface Props {
	repos: Repo[];
	profileUrl: string;
	profileUser: string;
}

const { repos, profileUrl, profileUser } = Astro.props;
---

<section class="work-section">
	<SectionHeading>Works</SectionHeading>
	<WorkList client:load initial={repos} profileUrl={profileUrl} profileUser={profileUser} />
	<MoreLink href={`${profileUrl}?tab=repositories`} />
</section>
