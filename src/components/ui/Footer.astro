---
interface Props {
	repoUrl?: string;
}

const { repoUrl = 'https://github.com/otnc' } = Astro.props;
---

<footer class="footer">
	<div class="footer-contents">
		<section class="contact" aria-labelledby="contact-heading">
			<h2 id="contact-heading" class="contact-heading">
				Contact
			</h2>
			<a class="contact-link" href="mailto:contact@montblank.fun">
				contact@montblank.fun
			</a>
		</section>
		<p>2022 - 2026</p>
		<a href={repoUrl} target="_blank" rel="noopener noreferrer">
			&copy; まろん｡ - All rights reserved.
		</a>
	</div>
</footer>

<style>
	.footer {
		background-color: var(--color-text);
	}

	.footer-contents {
		margin: 12px 0;
		padding: 8px 0;
		text-align: center;
		color: var(--color-surface);
		font-size: 14px;
	}

	.footer-contents p {
		margin: 0 0 4px;
		opacity: 0.7;
	}

	.footer-contents a:hover {
		text-decoration: underline;
	}

	.contact {
		margin-bottom: 14px;
		padding-bottom: 14px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.15);
	}

	.contact-heading {
		margin: 0 0 4px;
		font-size: 16px;
		letter-spacing: 0.05em;
	}

	.contact-link {
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
