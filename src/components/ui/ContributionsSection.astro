---
import SectionHeading from '../parts/SectionHeading.astro';
import ContributionList from '../islands/ContributionList';
import type { Contribution } from '../../lib/github';

interface Props {
	contributions: Contribution[];
	profileUser: string;
}

const { contributions, profileUser } = Astro.props;
---

<section class="contributions-section">
	<SectionHeading>Contributions</SectionHeading>
	<ContributionList client:load initial={contributions} profileUser={profileUser} />
</section>
