---
import Button from '../parts/Button.astro';

interface Props {
	code: string;
	title: string;
	description: string;
	variant: 'notfound' | 'teapot';
}

const { code, title, description, variant } = Astro.props;
const backgroundSrc = variant === 'teapot' ? '/teapot.png' : '/notfound.png';
---

<div class={`error-hero ${variant}`} style={{ backgroundImage: `url(${backgroundSrc})` }}>
	<div class="error-content">
		<p class="error-code">{code}</p>
		<div class="message-card">
			<h1 class="error-title">{title}</h1>
			<p class="error-description">{description}</p>
			<Button href="/" variant="primary">
				トップページへ戻る
			</Button>
		</div>
	</div>
</div>

<style>
	.error-hero {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: calc(100vh - var(--header-height, 84px));
		padding: 48px 20px;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		overflow: hidden;
	}

	.error-hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.25) 100%);
	}

	.error-content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		max-width: 480px;
		width: 100%;
		text-align: center;
		color: #ffffff;
	}

	.error-code {
		margin: 0;
		font-size: 72px;
		font-weight: 700;
		line-height: 1;
		text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
	}

	.message-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		margin-top: 12px;
	}

	.error-title {
		margin: 0;
		font-size: 22px;
		font-weight: 600;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
	}

	.error-description {
		margin: 0 0 8px;
		font-size: 14px;
		line-height: 1.6;
		opacity: 0.9;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
	}
</style>
