---
interface Props {
	title: string;
	url: string;
	description?: string;
	pubDate?: string;
}

const { title, url, description, pubDate } = Astro.props;

const formattedDate = pubDate
	? new Date(pubDate).toLocaleDateString('ja-JP', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
		})
	: undefined;
---

<a class="blog-post-card" href={url} target="_blank" rel="noopener noreferrer">
	<div class="text">
		<p class="title">{title}</p>
		{description && <p class="description">{description}</p>}
		{formattedDate && <p class="date">{formattedDate}</p>}
	</div>
	<span class="arrow" aria-hidden="true">
		→
	</span>
</a>

<style>
	.blog-post-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 14px;
		padding: 20px 22px;
		transition: background-color 0.15s;
	}

	.blog-post-card:hover {
		background-color: var(--color-surface-alt);
	}

	.text {
		min-width: 0;
	}

	.title {
		margin: 0;
		font-size: 16px;
		font-weight: 600;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.description {
		margin: 5px 0 0;
		color: var(--color-text-light);
		font-size: 13px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.date {
		margin: 7px 0 0;
		color: var(--color-text-muted);
		font-size: 12px;
	}

	.arrow {
		color: var(--color-accent-start);
		font-size: 20px;
	}
</style>
