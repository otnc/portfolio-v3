# /etc/anubis/marron-portfolio.env
#
# Anubis は公式の apt リポジトリ / Debパッケージでインストールする想定
# (https://anubis.techaro.lol/docs/admin/installation/)。
# インストール後、このファイルを配置して systemd サービスに読ませる:
#
#   sudo cp deploy/anubis.env /etc/anubis/marron-portfolio.env
#   sudo systemctl enable --now anubis@marron-portfolio

# nginx から受ける側。127.0.0.1 限定で外部には出さない。
# 同じVPSで他のAnubisインスタンスやアプリが動いている場合、ポートが
# 衝突していないか (ss -tlnp) 事前に確認すること。
BIND=127.0.0.1:8923
BIND_NETWORK=tcp

# ボット判定を通過したリクエストの転送先 = 我々の Hono アプリ。
# server/.env の PORT と一致させる。
TARGET=http://127.0.0.1:3000

# ボット判定ポリシー。deploy/anubis-policy.yaml (既定ポリシー + Open Graph
# passthroughのみ有効化) を使う。これが無いと、Discord/Twitter/Slack等の
# リンクプレビューボットがPoWチャレンジを解けず、OGPが一切表示されなくなる。
# sudo cp deploy/anubis-policy.yaml /etc/anubis/marron-portfolio-policy.yaml
POLICY_FNAME=/etc/anubis/marron-portfolio-policy.yaml

# クッキーに載せるドメイン。実際のドメインに置き換える。
COOKIE_DOMAIN=example.com

# ロボットテキスト応答はオリジン(Hono)側に任せる。
SERVE_ROBOTS_TXT=false

# PoW の難易度。既定値で気にならなければ変更不要。
# DIFFICULTY=4
