# GitHub API の未認証レート制限(60req/h, 検索は10req/min)を避けたい場合に設定する。
# Settings > Developer settings > Personal access tokens で取得できる、
# public_repo 程度の権限があれば十分。
GITHUB_TOKEN=

# server/ (自前のGitHub活動集計API) を立てた場合はそのURLを指定する。
# 例: http://127.0.0.1:3050/api/github/otnc
# 未設定なら暫定で外部API (montblank.fun) にフォールバックする。
GITHUB_ACTIVITY_API_URL=
