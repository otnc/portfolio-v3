# GitHub GraphQL API を叩くためのトークン(必須)。
# public_repo 程度のスコープで十分。
GITHUB_TOKEN=

# 集計対象にする既定のGitHubユーザー名。
GITHUB_DEFAULT_USER=otnc

# Hono サーバーの待受ポート。nginx/Anubis からはこのポートへ到達させる。
# src/lib/githubActivity.ts のURLとも一致させること。
PORT=3010

# Astro のビルド成果物 (dist/) の場所。相対パスは server/ からの相対。
STATIC_DIR=../dist

# キャッシュの有効期限(秒)。切れたら次のリクエストでバックグラウンド再取得する。
CACHE_TTL_SECONDS=43200

# 起動時 + この間隔(ミリ秒)ごとにキャッシュを事前に温め直す。
REFRESH_INTERVAL_MS=43200000
